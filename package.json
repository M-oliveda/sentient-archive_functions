{
  "name": "sentient-archive-functions",
  "version": "1.0.0",
  "description": "Backend API for SentientArchive - Personal Knowledge Base system built with Firebase Cloud Functions",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && npm run copy:config",
    "copy:config": "mkdir -p lib/config && cp -r src/config/*.toml lib/config/",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit:coverage": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --coverage",
    "test:ci": "firebase emulators:exec --only firestore,auth 'npm run test' --project demo-sentient-archive",
    "test:ci:unit": "npm run test:unit:coverage",
    "prepare": "[ -d .git ] && husky || echo 'Skipping husky in non-git environment'",
    "seed": "./scripts/run-seed.sh",
    "seed:fresh": "npm run emulators:reset && npm run seed",
    "emulators:start": "docker compose up -d",
    "emulators:stop": "docker compose down",
    "emulators:logs": "docker compose logs -f",
    "emulators:rebuild": "docker compose down && docker compose build --no-cache && docker compose up -d",
    "emulators:reset": "docker compose down -v && rm -rf firebase/emulator-data/* && docker compose up -d",
    "emulators:export": "docker compose exec firebase-emulators firebase emulators:export /app/firebase/seed --project demo-sentient-archive --force"
  },
  "keywords": [
    "firebase",
    "cloud-functions",
    "typescript",
    "gemini-ai",
    "knowledge-base",
    "serverless"
  ],
  "author": "M-oliveda",
  "license": "GPL-2.0",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "busboy": "^1.6.0",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^7.0.3",
    "pdf-parse": "^1.1.1",
    "smol-toml": "^1.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^9.3.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "firebase-functions-test": "^3.3.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
